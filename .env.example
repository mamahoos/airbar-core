# airbar-core environment template.
# Copy to `.env` for local dev. Production injects these via the orchestrator.

# --- app ---
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,https://airbar.app,https://www.airbar.app
THROTTLE_TTL=60
THROTTLE_LIMIT=100
LOG_LEVEL=debug

# --- database (airbar_api) ---
# Host port 5435 to avoid clashing with other local Airbar Postgres instances.
DATABASE_URL=postgresql://airbar:airbar_secret@localhost:5435/airbar_api?schema=public
DB_USER=airbar
DB_PASSWORD=airbar_secret
DB_NAME=airbar_api

# --- redis ---
# Host port 6382 to avoid clashing with other local Airbar Redis instances.
REDIS_HOST=localhost
REDIS_PORT=6382

# --- finance gRPC (airbar-finance) ---
FINANCE_GRPC_URL=localhost:50051
FINANCE_GRPC_TLS=false

# --- reserved for later phases (left here so .env has a single source) ---
# JWT_SECRET=                    # N2
# JWT_REFRESH_SECRET=            # N2
# SMS_PROVIDER=limosms           # N2
# LIMOSMS_API_KEY=               # N2
# MINIO_ENDPOINT=localhost       # N3
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=airbar
# MINIO_USE_SSL=false
# API_IR_API_KEY=                # N3 (KYC)
# INTERNAL_API_KEY=              # N7
# INTAKE_API_KEY=                # N7
# FRONTEND_URL=https://airbar.app # N6 (post-pay redirect)
