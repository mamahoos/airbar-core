# airbar-core environment template.
# Copy to `.env` for local dev. Production injects these via the orchestrator.

# --- app ---
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,https://airbar.app,https://www.airbar.app
THROTTLE_TTL=60
THROTTLE_LIMIT=100
LOG_LEVEL=debug

# --- database (airbar_api) ---
# Host port 5435 to avoid clashing with other local Airbar Postgres instances.
DATABASE_URL=postgresql://airbar:airbar_secret@localhost:5435/airbar_api?schema=public
DB_USER=airbar
DB_PASSWORD=airbar_secret
DB_NAME=airbar_api

# --- redis ---
# Host port 6382 to avoid clashing with other local Airbar Redis instances.
REDIS_HOST=localhost
REDIS_PORT=6382

# --- finance gRPC (airbar-finance) ---
FINANCE_GRPC_URL=localhost:50051
FINANCE_GRPC_TLS=false
FRONTEND_URL=http://localhost:3000
OUTBOX_MAX_ATTEMPTS=10

# --- auth (N2) ---
JWT_SECRET=dev-only-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-only-jwt-refresh-secret-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
OTP_LENGTH=6
OTP_EXPIRES_IN=300
OTP_MAX_PER_HOUR=10
OTP_COOLDOWN_SECONDS=60
SMS_PROVIDER=dev
# LIMOSMS_API_KEY=
# LIMOSMS_SENDER_NUMBER=
# LIMOSMS_OTP_PATTERN=
# API_IR_BEARER_TOKEN=
# API_IR_DEV_MOCK=true
# API_IR_BASE_URL=https://s.api.ir/api/sw1
# API_IR_TIMEOUT_MS=15000

# --- PII encryption (N3) — 32-byte key as 64 hex chars ---
PII_ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# --- MinIO (N3 avatars / KYC docs) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=airbar
MINIO_USE_SSL=false

# --- reserved for later phases ---
# MINIO_ENDPOINT=localhost       # N3
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=airbar
# MINIO_USE_SSL=false
# API_IR_API_KEY=                # N3 (KYC)
# INTERNAL_API_KEY=              # N7
# INTAKE_API_KEY=                # N7
# FRONTEND_URL=https://airbar.app # N6 (post-pay redirect)
