// AirBar Core — marketplace orchestrator (airbar_api database).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  CARRIER
  ADMIN
  SUPER_ADMIN
}

enum KycLevel {
  NONE
  MOBILE_VERIFIED
  IDENTITY_VERIFIED
  DOCUMENT_VERIFIED
  FACE_VERIFIED
  FULLY_VERIFIED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                        String    @id @default(uuid())
  phone                     String    @unique
  email                     String?   @unique
  passwordHash              String?   @map("password_hash")
  firstName                 String?   @map("first_name")
  lastName                  String?   @map("last_name")
  avatarUrl                 String?   @map("avatar_url")
  bio                       String?
  role                      UserRole  @default(USER)
  kycLevel                  KycLevel  @default(NONE) @map("kyc_level")
  isActive                  Boolean   @default(true) @map("is_active")
  isBanned                  Boolean   @default(false) @map("is_banned")
  banReason                 String?   @map("ban_reason")
  rating                    Float     @default(0)
  totalTrips                Int       @default(0) @map("total_trips")
  totalShipments            Int       @default(0) @map("total_shipments")
  identityPendingPersonInfo Boolean   @default(false) @map("identity_pending_person_info")
  financialVerifiedAt       DateTime? @map("financial_verified_at")
  lastLoginAt               DateTime? @map("last_login_at")
  lastLoginIp               String?   @map("last_login_ip")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  sessions         Session[]
  activityLogs     ActivityLog[]
  kycDocuments     KycDocument[]
  identityProfile  UserIdentityProfile?
  bankAccounts     UserBankAccount[]
  addresses        UserAddress[]
  payoutProfile    UserPayoutProfile?
  trips            Trip[]
  sentShipments    Shipment[] @relation("SenderShipments")
  carriedShipments Shipment[] @relation("CarrierShipments")
  notifications    Notification[]
  chatMessages     ChatMessage[]
  reviewsAuthored  Review[]     @relation("ReviewAuthor")
  reviewsReceived  Review[]     @relation("ReviewTarget")

  @@map("users")
}

model UserIdentityProfile {
  userId                  String    @id @map("user_id")
  nationalIdHash          String    @unique @map("national_id_hash")
  nationalIdCiphertext    String    @map("national_id_ciphertext")
  firstNameOfficial       String?   @map("first_name_official")
  lastNameOfficial        String?   @map("last_name_official")
  fatherName              String?   @map("father_name")
  birthDate               DateTime? @map("birth_date")
  birthDateJalali         String?   @map("birth_date_jalali")
  gender                  String?
  isAlive                 Boolean?  @map("is_alive")
  personInfoRaw           Json?     @map("person_info_raw")
  shahkarVerifiedAt       DateTime? @map("shahkar_verified_at")
  personInfoVerifiedAt    DateTime? @map("person_info_verified_at")
  personImageStorageKey   String?   @map("person_image_storage_key")
  passportNumber          String?   @map("passport_number")
  passportStatusRaw       Json?     @map("passport_status_raw")
  identityPendingPersonInfo Boolean @default(false) @map("identity_pending_person_info")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_identity_profiles")
}

model UserBankAccount {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  cardNumberMasked    String    @map("card_number_masked")
  cardNumberHash      String    @map("card_number_hash")
  cardNumberCiphertext String?  @map("card_number_ciphertext")
  ibanHash            String?   @map("iban_hash")
  ibanCiphertext      String?   @map("iban_ciphertext")
  bankName            String?   @map("bank_name")
  accountHolderName   String?   @map("account_holder_name")
  cardMatchVerifiedAt DateTime? @map("card_match_verified_at")
  ibanMatchVerifiedAt DateTime? @map("iban_match_verified_at")
  isDefault           Boolean   @default(false) @map("is_default")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardNumberHash])
  @@index([userId])
  @@map("user_bank_accounts")
}

model UserPayoutProfile {
  userId         String   @id @map("user_id")
  ibanHash       String   @unique @map("iban_hash")
  ibanCiphertext String   @map("iban_ciphertext")
  accountName    String?  @map("account_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_payout_profiles")
}

model UserAddress {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  label       String?
  postalCode  String   @map("postal_code")
  fullAddress String?  @map("full_address")
  province    String?
  city        String?
  district    String?
  latitude    Float?
  longitude   Float?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([postalCode])
  @@map("user_addresses")
}

model KycDocument {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String
  fileUrl         String    @map("file_url")
  status          KycStatus @default(PENDING)
  verifiedBy      String?   @map("verified_by")
  verifiedAt      DateTime? @map("verified_at")
  rejectionReason String?   @map("rejection_reason")
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("kyc_documents")
}

model Session {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  token      String   @unique
  deviceInfo Json?    @map("device_info")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Otp {
  id        String   @id @default(uuid())
  phone     String
  code      String
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone, code])
  @@map("otps")
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  resource   String
  resourceId String?  @map("resource_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("activity_logs")
}

enum TripStatus {
  DRAFT
  ACTIVE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  MATCHED
  ACCEPTED
  PAYMENT_PENDING
  PAID
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CONFIRMED
  DISPUTED
  CANCELLED
  REFUNDED
}

enum CargoType {
  DOCUMENTS
  ELECTRONICS
  CLOTHING
  FOOD
  MEDICINE
  COSMETICS
  JEWELRY
  OTHER
}

enum Currency {
  IRR
  USD
  EUR
  USDT
}

model Trip {
  id                 String     @id @default(uuid())
  userId             String     @map("user_id")
  originCity         String     @map("origin_city")
  originCountry      String     @map("origin_country")
  originAirport      String?    @map("origin_airport")
  destinationCity    String     @map("destination_city")
  destinationCountry String     @map("destination_country")
  destinationAirport String?    @map("destination_airport")
  departureDate      DateTime   @map("departure_date")
  arrivalDate        DateTime?  @map("arrival_date")
  flightNumber       String?    @map("flight_number")
  availableWeight    Float      @map("available_weight")
  maxWeight          Float      @map("max_weight")
  availableVolume    Float?     @map("available_volume")
  acceptedCargoTypes CargoType[] @map("accepted_cargo_types")
  restrictions       String[]
  notes              String?
  basePricePerKg     Int        @map("base_price_per_kg")
  currency           Currency   @default(IRR)
  status             TripStatus @default(DRAFT)
  isVerified         Boolean    @default(false) @map("is_verified")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  shipments Shipment[]

  @@index([userId])
  @@index([originCity, destinationCity])
  @@index([departureDate])
  @@index([status])
  @@map("trips")
}

model Shipment {
  id                  String         @id @default(uuid())
  trackingCode        String         @unique @map("tracking_code")
  senderId            String         @map("sender_id")
  carrierId           String?        @map("carrier_id")
  tripId              String?        @map("trip_id")
  originCity          String         @map("origin_city")
  originCountry       String         @map("origin_country")
  originAddress       String?        @map("origin_address")
  originLocation      Json?          @map("origin_location")
  destinationCity     String         @map("destination_city")
  destinationCountry  String         @map("destination_country")
  destinationAddress  String?        @map("destination_address")
  destinationLocation Json?          @map("destination_location")
  cargoType           CargoType      @map("cargo_type")
  description         String
  weight              Float
  dimensions          Json?
  declaredValue       Int?           @map("declared_value")
  photos              String[]
  pickupDate          DateTime?      @map("pickup_date")
  deliveryDate        DateTime?      @map("delivery_date")
  senderContact       Json?          @map("sender_contact")
  receiverContact     Json           @map("receiver_contact")
  systemPrice         Int            @map("system_price")
  agreedPrice         Int?           @map("agreed_price")
  currency            Currency       @default(IRR)
  status              ShipmentStatus @default(PENDING)
  currentLocation     Json?          @map("current_location")
  trackingHistory     Json[]         @map("tracking_history")
  financeEscrowId     String?        @map("finance_escrow_id")
  paymentOrderId      String?        @map("payment_order_id")
  paymentMethod       String?        @map("payment_method")
  pickedUpAt          DateTime?      @map("picked_up_at")
  deliveredAt         DateTime?      @map("delivered_at")
  confirmedAt         DateTime?      @map("confirmed_at")
  disputeReason       String?        @map("dispute_reason")
  disputedAt          DateTime?      @map("disputed_at")
  disputedById        String?        @map("disputed_by_id")
  disputeResolvedAt   DateTime?      @map("dispute_resolved_at")
  disputeResolution   String?        @map("dispute_resolution")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  sender  User  @relation("SenderShipments", fields: [senderId], references: [id], onDelete: Cascade)
  carrier User? @relation("CarrierShipments", fields: [carrierId], references: [id])
  trip    Trip? @relation(fields: [tripId], references: [id])
  chat    Chat?
  reviews Review[]

  @@index([senderId])
  @@index([carrierId])
  @@index([tripId])
  @@index([trackingCode])
  @@index([status])
  @@map("shipments")
}

model PricingRule {
  id                 String     @id @default(uuid())
  name               String
  description        String?
  originCountry      String?    @map("origin_country")
  destinationCountry String?    @map("destination_country")
  cargoType          CargoType? @map("cargo_type")
  basePrice          Int        @map("base_price")
  pricePerKg         Int        @map("price_per_kg")
  pricePerKm         Int?       @map("price_per_km")
  riskMultiplier     Float      @default(1) @map("risk_multiplier")
  platformFeePercent Float      @default(10) @map("platform_fee_percent")
  minPlatformFee     Int        @default(0) @map("min_platform_fee")
  isActive           Boolean    @default(true) @map("is_active")
  priority           Int        @default(0)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  @@map("pricing_rules")
}

model City {
  id          String  @id @default(uuid())
  name        String
  nameEn      String  @map("name_en")
  country     String
  countryCode String  @map("country_code")
  latitude    Float?
  longitude   Float?
  timezone    String?
  isActive    Boolean @default(true) @map("is_active")

  @@unique([name, country])
  @@index([country])
  @@map("cities")
}

model Airport {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  nameEn      String  @map("name_en")
  city        String
  country     String
  countryCode String  @map("country_code")
  latitude    Float?
  longitude   Float?
  isActive    Boolean @default(true) @map("is_active")

  @@index([city])
  @@index([country])
  @@map("airports")
}

enum NotificationType {
  PUSH
  SMS
  EMAIL
}

model Chat {
  id         String   @id @default(uuid())
  shipmentId String   @unique @map("shipment_id")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  shipment Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@map("chats")
}

model ChatMessage {
  id          String    @id @default(uuid())
  chatId      String    @map("chat_id")
  senderId    String    @map("sender_id")
  content     String
  attachments String[]
  isRead      Boolean   @default(false) @map("is_read")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([senderId])
  @@map("chat_messages")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")
  sentAt    DateTime?        @map("sent_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model Review {
  id            String   @id @default(uuid())
  shipmentId    String   @map("shipment_id")
  authorId      String   @map("author_id")
  targetId      String   @map("target_id")
  rating        Int
  comment       String?
  communication Int?
  punctuality   Int?
  packaging     Int?
  overall       Int?
  isVisible     Boolean  @default(true) @map("is_visible")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  author   User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  target   User     @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, authorId])
  @@index([targetId])
  @@map("reviews")
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}
